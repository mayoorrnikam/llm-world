.DS_Store

# Local Claude Code settings — machine-specific, not shared
.claude/settings.local.json
*.log
node_modules/
.venv/
__pycache__/

# Project briefs — working notes, not site content (repo root is served publicly)
Build the definitive*.txt

# Bulk export artifacts — generated only with --export, never committed
api/
llm-releases.csv
.build-check/

# Generated by scripts/build.mjs in CI — not committed
models/
companies/
timeline/
analytics/
compare/
latest/
data-quality/
families/
milestones/
methodology/
taxonomy/
sitemap.xml
robots.txt

# Local planning docs — never commit or push (2026-08-09).
# METHODOLOGY.md and TAXONOMY.md are the exceptions: they are published at
# /methodology/ and /taxonomy/, so they have to be in the repo the build runs
# against. The charter and the execution order stay local.
docs/*
!docs/METHODOLOGY.md
!docs/TAXONOMY.md
.source-cache/
